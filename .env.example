# Скопіюйте цей файл у .env і змініть значення: cp .env.example .env  (Windows: copy .env.example .env)
# Файл .env у Git не додається.

# Flask
# Випадковий ключ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-random-string
# 0 - вимкнено (production), 1 - режим налагодження (лише для розробки)
FLASK_DEBUG=0
# Рівень логування: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Резервні копії бази даних (використовує сервіс backup)
# Скільки останніх копій зберігати
BACKUP_KEEP=7
# Як часто робити копію, у секундах (86400 = раз на добу)
BACKUP_INTERVAL_SECONDS=86400

# Шлях до бази даних (DATABASE_PATH) у контейнері задається в compose.yaml: /app/data/database.db.
# Локально без Docker він не потрібен: база створюється в data/database.db.
